# Application Ports
APP_PORT=8000
DB_PORT=5432
REDIS_PORT=6379

# PostgreSQL Configuration
DB_DATABASE=cex_db
DB_USERNAME=cex_user
DB_PASSWORD=secret123

# Redis Configuration
REDIS_PASSWORD=secretredis

# Laravel Octane Settings
APP_NAME=CEX_Core
APP_ENV=local
APP_KEY=base64:lxk5EM+KMztVAigfkqVMvjkJwyb5PxnhSZdo79oRFQE=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Blockchain RPC Endpoints & Testnet
RPC_ETH_MAINNET=https://rpc.ankr.com/eth
RPC_BSC_MAINNET=https://rpc.ankr.com/bsc
RPC_ETH_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
NETWORK_DEFAULT=SEPOLIA

# HD Wallet (Deposit Address Generator)
# Gunakan Master Extended Public Key (xPub) agar private key tidak pernah tersimpan di worker server!
# Format xpub (BIP44 EVM): xpub6CPo26VfaxGaMiXN7sgbFke3a9p2PMEvckDidN1NdQqhtsrN7NZoxRaKZYdQQLtjG7x6W283bBufRxeMWG2Eko8LosY2vy8kZudeWzEDEKA
MASTER_XPUB_EVM=xpub6CPo26VfaxGaMiXN7sgbFke3a9p2PMEvckDidN1NdQqhtsrN7NZoxRaKZYdQQLtjG7x6W283bBufRxeMWG2Eko8LosY2vy8kZudeWzEDEKA
# Fallback Mnemonic untuk testing lokal jika xPub belum diset
MASTER_MNEMONIC="endorse hire setup spell output yard day hood lake jazz spoon office"

# Hot Wallet (Withdrawal Dispatcher)
# Private key Hot wallet bursa (pastikan saldo di hot wallet hanya 5-10% dari total reserve)
HOT_WALLET_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ERC-20 Token Addresses (Sepolia Testnet)
USDT_CONTRACT_SEPOLIA=0xaA8E23Fb1079EA71e0a56F48a2aA51851D8433D0
